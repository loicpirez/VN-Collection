{
  "name": "vndb-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "smoke": "bash scripts/smoke.sh",
    "qa": "bash scripts/browser-qa.sh",
    "qa:interactions": "node scripts/browser-interactions.mjs",
    "sentinel": "node scripts/frontend-regression-sentinel.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "bash scripts/test-coverage.sh",
    "test:postgres": "bash scripts/test-postgres.sh",
    "test:postgres:run": "vitest run --config vitest.postgres.config.ts",
    "db:postgres:baseline": "node scripts/generate-postgres-baseline.mjs",
    "db:postgres:apply": "tsx scripts/apply-postgres-migrations.ts",
    "db:postgres:migrate": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:postgres:verify": "tsx scripts/verify-postgres-migration.ts",
    "db:postgres:smoke": "tsx scripts/smoke-postgres-repositories.ts",
    "db:postgres:dev:up": "docker compose up -d --wait postgres",
    "db:postgres:dev:down": "docker compose down",
    "db:postgres:test:up": "docker compose -f docker-compose.test.yml up -d --wait postgres",
    "db:postgres:test:down": "docker compose -f docker-compose.test.yml down",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/recharts": "^2.0.1",
    "better-sqlite3": "^11.10.0",
    "https-proxy-agent": "^9.0.0",
    "iconv-lite": "^0.7.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "^8.5.26"
  },
  "resolutions": {
    "ip-address": "^10.5.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "undici": "^7.29.0",
    "vite": "^8.2.2"
  }
}
